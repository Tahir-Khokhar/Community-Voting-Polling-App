# Copy this file to ".env" and fill in real values for your environment.
# ".env" is gitignored — never commit real secrets. In production load these
# from your host's secret manager / environment, not from a checked-in file.

# --- Core Django ----------------------------------------------------------
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(60))"
# Must be >= 50 chars and high-entropy. Never use the dev fallback in prod.
DJANGO_SECRET_KEY=

# "True" for local dev, "False" for production. When False, HSTS, HTTPS
# redirect, and Secure session/CSRF/voter cookies are enabled automatically.
DJANGO_DEBUG=True

# Comma-separated hostnames the app will serve. Avoid "*" in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -------------------------------------------------------------
# Leave DJANGO_DB_ENGINE unset to use the bundled SQLite (local dev).
# For production PostgreSQL (requires psycopg):
#   DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_ENGINE=
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=

# --- Cache (vote-attempt throttle) ----------------------------------------
# LocMemCache (per-process) is fine for dev. For production use a shared
# backend so the throttle counter is consistent across workers:
#   DJANGO_CACHE_BACKEND=django_redis.cache.RedisCache
#   DJANGO_CACHE_LOCATION=redis://127.0.0.1:6372/1
DJANGO_CACHE_BACKEND=
DJANGO_CACHE_LOCATION=

# --- Email (password-reset flow) ------------------------------------------
# Leave unset to log email to the console (dev). For production SMTP:
#   DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_BACKEND=
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com
